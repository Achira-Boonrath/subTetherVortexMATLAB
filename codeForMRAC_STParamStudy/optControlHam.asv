
close all; clear all; clc

%%

syms x1(t) x2(t) x3(t) x4(t) L1(t) L2(t) L3(t) L4(t) ux(t) uy(t) 

mu = 398600;

eqns = [diff(L1,t) == L3*mu*((-2*x1^2 + x2^2)/(x1^2 + x2^2)^(5/2)),...
        diff(L2,t) == L4*mu*((-2*x2^2 + x1^2)/(x1^2 + x2^2)^(5/2)),...
        diff(L3,t) == -L1*x3,...
        diff(L4,t) == -L2*x4,...
        diff(x1,t) == x3,...
        diff(x2,t) == x4,...
        diff(x3,t) == -x1*mu/((x1^2 + x2^2)^(3/2)) - L3,...
        diff(x4,t) == -x2*mu/((x1^2 + x2^2)^(3/2)) - L4,...
        ];

S = dsolve(eqns);

%%
t0 = 0;
tf = 1.5 * 0.5*3600;

r0 = 780+6378;
eqnsSub = [subs( S.x1,t0 ) == 780+6378,...
           subs( S.x2,t0 ) == 0,...
           subs( S.x3,t0 ) == 0,...
           subs( S.x4,t0 ) == sqrt(mu/r0),...
           subs( S.x1,tf ) == x3,...
           subs( S.x2,tf ) == x4,...
           subs( S.x3,tf ) == -x1*mu/((x1^2 + x2^2)^(3/2)) - L3,...
           subs( S.x4,tf ) == -x2*mu/((x1^2 + x2^2)^(3/2)) - L4,...
           ];