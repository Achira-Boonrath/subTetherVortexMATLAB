
    orbitTrueAnamoly = 180;
    r0 = orbitSemiMajorAxis0;
    orbitSemiMajorAxis = (orbitSemiMajorAxis1 + orbitSemiMajorAxis0)/2;
    [t, x, lambda, u] = orbitTransferData(orbitSemiMajorAxis1, orbitTrueAnamoly, orbitSemiMajorAxis0);
    
    %% Problem data
    orbitEccentricity = 0;
    % r0 = 780+6378;
    muVal = 398600;
    % Initial state: x, y, z (m), vx, vy, vz (m/s), m (kg)
    x0 = [r0 0 0 0 sqrt(muVal/r0) 0 2000]';           
    
    theta_f = deg2rad(orbitTrueAnamoly);
    % Radius magnitude
    p = orbitSemiMajorAxis * (1 - orbitEccentricity^2);
    r_mag = p / (1 + orbitEccentricity*cos(theta_f));
    rf = r_mag;

    %% Animation
