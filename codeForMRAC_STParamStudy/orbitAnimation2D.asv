   %  % Calculate scaling for thrust vector visualization
   %  % We want the max thrust vector to correspond to roughly 15% of the plot span
   %  x_span = max(x(:,1)) - min(x(:,1));
   %  y_span = max(x(:,2)) - min(x(:,2));
